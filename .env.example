# URL pública da API (backend)
# Em produção: https://api.seudominio.com
# Em dev local: http://localhost:3000
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Libera o auto-cadastro de empresa (página /register + link no login).
# Mantenha igual à flag PUBLIC_SIGNUP_ENABLED do backend, que faz o enforcement real.
NEXT_PUBLIC_SIGNUP_ENABLED="false"

# ─── Suporte ────────────────────────────────────────────────────────────────
# Canal de atendimento humano, usado hoje pelo pedido de estorno dentro do prazo
# de arrependimento (7 dias, CDC art. 49) na tela de cobrança.
#
# SEM o prefixo NEXT_PUBLIC_ de propósito: é lido no servidor e desce como prop.
# Com NEXT_PUBLIC_ o valor seria gravado no bundle durante o build, e trocar o
# número exigiria rebuild da imagem — assim basta reiniciar o container.
#
# O WhatsApp tem prioridade sobre o e-mail. Enquanto os dois estiverem vazios, o
# botão aparece desabilitado — ninguém clica num link que não leva a lugar nenhum.
# Formato do WhatsApp: só dígitos, com DDI e DDD (ex.: 5511999999999).
SUPPORT_WHATSAPP=""
SUPPORT_EMAIL=""
